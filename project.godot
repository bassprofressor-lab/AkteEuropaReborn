; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AkteEuropaReborn"
config/description="Clean-room RTS remake of Akte Europa (1997)"
config/version="0.6.0"
run/main_scene="res://Scenes/Main/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://Assets/Textures/Icon.png"

; ⚠ 18.08.2026 — KEIN GODOT-LOGO MEHR BEIM START. Der Motor gehört nicht auf
; den Startbildschirm eines Spiels; die Farbe ist dieselbe wie der Hintergrund
; des Hauptmenüs, damit der Übergang nicht blinkt.
;
; ⚠ Ein EIGENES Bild ist damit noch nicht da, sondern nur der Platz dafür: es
; müsste als Datei im Projekt liegen (`res://`), und der Inhalt des Spiels
; entsteht erst beim Spieler aus seinen CDs — aus ihm lässt sich also kein
; Startbild nehmen. Wer eines will, legt eine PNG nach Assets/Textures und
; trägt sie hier als `boot_splash/image` ein.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.1, 0.1, 0.12, 1)

[autoload]

GameManager="*res://Scripts/Core/GameManager.cs"
AssetRegistry="*res://Scripts/Core/AssetRegistry.cs"
FogOfWar="*res://Scripts/Rendering/FogOfWar.cs"
Pathfinder="*res://Scripts/Simulation/Pathfinder.cs"
NetworkManager="*res://Scripts/Network/NetworkManager.cs"
; CampaignManager is a static class, not a Node — it holds the mission list and
; the progress number and is asked, not ticked.
AudioManager="*res://Scripts/Audio/AudioManager.cs"
InputManager="*res://Scripts/Core/InputManager.cs"
SelectionManager="*res://Scripts/UI/SelectionManager.cs"
; CommandManager is a static class, not a Node — the command ring belongs to the
; SIMULATION (MapEntityLayer.Commands) and is ticked from SimTick, because the
; twin harness runs two simulations in one process and the command harness three;
; a single autoload node would make them share one ring. Same reason as
; CampaignManager above: it is asked, not ticked.
ReplayManager="*res://Scripts/Simulation/ReplayManager.cs"
DebugOverlay="*res://Scripts/Debug/DebugOverlay.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true

[debug]

; ⚠ 18.08.2026 — DIE AUSGELIEFERTE FASSUNG SCHREIBT JETZT EIN PROTOKOLL.
; Anlass: ein Absturz kurz nach dem Hauptmenü, der sich hier nicht auslösen
; liess (drei Minuten Menü, Gefecht und Kampagne — alles lief). Ohne Datei
; hinterlässt die exportierte Fassung KEINE Spur: sie hat kein Fenster für die
; Ausgabe, und die Protokolle im Benutzerordner stammten alle aus Läufen im
; Editor. Ein Fehler, den man nicht sehen kann, ist keiner, den man sucht —
; er ist einer, den man rät.
;
; Es landet in user://logs/ (%APPDATA%\Godot\app_userdata\AkteEuropaReborn\logs).
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=10

[dotnet]

project/assembly_name="Akte Europa Reborn"

[localization]

locale/filter="res://Localization/*.csv"

[physics]

2d/default_gravity=0

[rendering]

environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)
renderer/texture_filter="nearest"
