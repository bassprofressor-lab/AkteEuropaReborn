*.old
*.old.*
*.bak

Screenshot*.png
!docs/screenshots/*.png
Screenshot*.png.import

# Godot import stubs for the README screenshots (they are not exported)
docs/**/*.import

# Bildschirmfotos aus den Pruefstaenden — Belege fuer Meldungen, kein Quelltext.
Bug Bilder/

