{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/session-start.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/pre-read.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/pre-write.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/post-read.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/post-write.js"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/post-bash.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/stop.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "_managedBy": "openwolf",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.wolf/hooks/precompact.js"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}